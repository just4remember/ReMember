// Набор карточек игры «Космо» — правится вручную, приложение читает его как есть.
// Комментарии (// …) и запятая после последнего элемента разрешены.
//
// После правки — пересобрать приложение. Проверить баланс (сколько часов на прохождение):
//   gradlew testDebugUnitTest --tests "*ClickerBalanceSimulation*" --rerun
// отчёт с графиками — app/build/reports/clicker/balance.html.
//
// ПОЛЯ КАРТОЧКИ
//   id          — постоянный ключ: по нему хранится прогресс игрока. НЕ МЕНЯТЬ у существующих.
//   category    — id категории (см. «categories»).
//   name        — название на карточке.
//   image       — картинка вместо иконки категории: имя файла в app/src/main/assets/clicker/images/
//                 (например "volcano.webp"; лучше квадратная, 128–256 px). null — иконка категории.
//   overlay     — картинка поверх image (например, кольца Сатурна) из той же папки: может выходить
//                 за рамку иконки, обрезается только краем карточки. Рисуется, только если есть image
//   overlayScale — во сколько раз overlay больше рамки иконки (по умолчанию 1.6)
//   overlayOffsetX, overlayOffsetY — сдвиг overlay от центра в долях рамки иконки: X — вправо
//                 (минус — влево), Y — вниз (минус — вверх). 0.1 — на 10% рамки. По умолчанию 0
//   effect      — что даёт: income (коинов в час), boost (доля прибавки к доходу категории target),
//                 tap (коинов за тап), energy_max (объём энергии), energy_regen (энергии в секунду),
//                 offline_rate / offline_cap (доход вне игры: доля / часы).
//   baseCost    — цена первого уровня.  Цена уровня n (с нуля) = baseCost · costGrowthⁿ.
//   baseValue   — что даёт первый уровень. Уровень n даёт baseValue · valueGrowthⁿ; уровни складываются.
//   maxLevel    — больше уровней не купить (null — без предела).
//   requires    — условия открытия: [{ "card": id, "level": N }, …] — нужен уровень N у карточки id.
//   availableFrom / availableUntil — только для «Хаоса»: когда продаётся (секунды Unix).
{
  "version": 7,
  // ОБЩИЕ ПРАВИЛА
  "rules": {
    "goal": 4000000000000,                 // цель прохождения: столько заработать
    "stardustPerRun": 100,              // звёздной пыли за прохождение
    "maxRuns": 3,                       // сколько раз можно пройти; после последнего игра замирает
    "baseIncomePerHour": 0,             // доход в час без карточек
    "tapValue": 1,                      // коинов за тап без прокачки
    "tapIncomeSeconds": 0,              // ещё столько секунд пассивного дохода за тап
    "energyMax": 500,                   // энергия у нового игрока
    "energyRegen": 1,                   // восстановление энергии в секунду
    "tapCost": 1,                       // сколько энергии тратит тап
    "offlineRate": 0.4,                 // доля дохода вне игры
    "offlineCapHours": 3,               // вне игры доход копится не дольше стольких часов
    // уровни игрока (вид планеты): уровень n+1 — когда за прохождение заработано столько
    "levels": [0, 10000, 100000, 500000, 1000000, 10000000, 1000000000, 1000000000000],
  },

  // КАТЕГОРИИ. hidden — не показывается в «Улучшениях» (прокачка тапа — своей кнопкой);
  // temporary — временные карточки «Хаоса» (приходят с сервера)
  "categories": [
    { "id": "planet", "name": "Планета" },
    { "id": "orbit", "name": "Орбита" },
    { "id": "star", "name": "Звезда" },
    { "id": "galaxy", "name": "Галактика" },
    { "id": "universe", "name": "Вселенная" },
    { "id": "tap", "name": "Тап", "hidden": true },
    { "id": "chaos", "name": "Хаос", "temporary": true },
  ],

