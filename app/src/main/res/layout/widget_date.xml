<?xml version="1.0" encoding="utf-8"?>
<!-- Дата и огонёк серии под часами -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextClock
        android:id="@+id/clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:format12Hour="EEEE, d MMMM"
        android:format24Hour="EEEE, d MMMM"
        android:maxLines="1"
        android:textColor="#E6FFFFFF"
        android:textSize="14sp"
        android:shadowColor="#59000000"
        android:shadowDy="1"
        android:shadowRadius="4" />

    <ImageView
        android:id="@+id/streak_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_widget_flame" />

    <TextView
        android:id="@+id/streak_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textSize="14sp" />
</LinearLayout>
