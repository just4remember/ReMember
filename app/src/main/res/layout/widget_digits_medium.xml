<?xml version="1.0" encoding="utf-8"?>
<!-- Цифры цифровых часов: системный шрифт, толщина 500, с лёгкой тенью (на обоях) -->
<TextClock xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clock_digits"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFamily="sans-serif"
    android:fontFeatureSettings="tnum"
    android:fontVariationSettings="'wght' 500"
    android:format12Hour="h:mm"
    android:format24Hour="HH:mm"
    android:includeFontPadding="false"
    android:textColor="#FFFFFFFF"
    android:textSize="80sp"
    android:shadowColor="#59000000"
    android:shadowDy="1"
    android:shadowRadius="4" />
