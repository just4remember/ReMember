<?xml version="1.0" encoding="utf-8"?>
<!-- Дата и огонёк серии под часами (на подложке — без тени) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Дату пишет приложение на выбранном языке виджетов и обновляет в полночь -->
    <TextView
        android:id="@+id/clock_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="#E6FFFFFF"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/streak_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_widget_flame" />

    <TextView
        android:id="@+id/streak_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textSize="14sp" />
</LinearLayout>
