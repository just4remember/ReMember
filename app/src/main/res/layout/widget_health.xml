<?xml version="1.0" encoding="utf-8"?>
<!-- Здоровье: кольца (картинкой) и, если хватает места, цифры рядом. Размеры ставит код -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_card_bg"
        android:tint="#F21C1F26" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/health_rings"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/widget_health"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/health_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/health_row1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#99FFFFFF" />

            <TextView
                android:id="@+id/health_row2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#99FFFFFF" />

            <TextView
                android:id="@+id/health_row3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#99FFFFFF" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
