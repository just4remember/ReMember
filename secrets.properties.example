# Сервер отзывов (FeedbackServer): адрес приёма и APP_KEY из его .env
feedback.endpoint=https://feedback.example.com/api/feedback
feedback.key=

# Ссылка на сбор средств в банке для раздела «Поддержать автора». Пусто — раздела нет
support.url=

# Сколько отзывов в день можно отправить с одного телефона (по умолчанию 5)
feedback.dailyLimit=5
